# ==============================================================================
# SwiftDrop AI Assistant Service Environment Variables (.env.example)
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Server & Profile
SERVER_PORT=8084
SPRING_PROFILES_ACTIVE=dev

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Spring AI (Optional - if using spring-ai-starter-model-google-genai)
SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
SPRING_AI_GOOGLE_GENAI_CHAT_OPTIONS_MODEL=gemini-1.5-flash

# JWT Security (Must match gateway and auth-service)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Inter-Service Communication (For parcel tracking and rate lookups)
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PARCEL_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083

